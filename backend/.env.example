# ── Database ───────────────────────────────────────────────────────────────────
# SQLite for local dev. Replace with postgresql://user:pass@host/db for prod.
DATABASE_URL=sqlite:///./comic_studio.db

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage

# ── AI Generation Backend ──────────────────────────────────────────────────────
# Options: mock | comfyui | diffusers | colab
GENERATION_BACKEND=mock

# ── ComfyUI (local) ────────────────────────────────────────────────────────────
COMFYUI_URL=http://127.0.0.1:8188

# ── Colab Endpoint ─────────────────────────────────────────────────────────────
COLAB_ENDPOINT_URL=https://xxxx.ngrok.io
COLAB_API_KEY=

# ── Style LoRA ─────────────────────────────────────────────────────────────────
STYLE_LORA_PATH=comic_style_v1.safetensors
STYLE_LORA_TRIGGER=comic_style_v1
STYLE_LORA_WEIGHT=1.0

# ── SDXL Base Model ────────────────────────────────────────────────────────────
SDXL_CHECKPOINT=sd_xl_base_1.0.safetensors

# ── InstantID / IP-Adapter ─────────────────────────────────────────────────────
INSTANTID_MODEL=ip-adapter_instantid_sdxl.bin
INSTANTID_CONTROLNET=diffusion_pytorch_model.safetensors
IPADAPTER_FACEID_MODEL=ip-adapter-faceid-plusv2_sdxl.bin

# ── Google Drive ───────────────────────────────────────────────────────────────
GDRIVE_CREDENTIALS_FILE=./gdrive_credentials.json
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_SYNC_ENABLED=false
